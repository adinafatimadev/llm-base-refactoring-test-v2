{
  "$schema":"https://turbo.build/schema.json",
  "tasks":{
    "build":{"dependsOn":["^build"],"outputs":["dist/**",".output/**",".vinxi/**",".tanstack/**","generated/**"]},
    "dev":{"cache":false,"persistent":true},
    "lint":{},
    "typecheck":{},
    "test":{"outputs":["coverage/**"]},
    "test:unit":{"outputs":["coverage/**"]},
    "test:integration":{},
    "test:e2e":{"dependsOn":["build"]},
    "proto:generate":{"outputs":["generated/**"]},
    "db:generate":{},
    "db:migrate":{},
    "db:seed":{}
  }
}